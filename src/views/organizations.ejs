      <div class="organization-info">
        <h3>Educational Organizations</h3>
        <p>Organizations supporting education, learning opportunities, and student development.</p>
      </div>
    </article>

    <article class="organization-card">
      <img
        src="/images/organization-3.jpg"
        alt="Community volunteers helping people in need"
      >
      <div class="organization-info">
        <h3>Community Organizations</h3>
        <p>Organizations working to strengthen communities and help people in need.</p>
      </div>
